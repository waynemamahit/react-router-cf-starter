{
  "name": "react-router-cf-starter",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "postinstall": "pnpm typecheck",
    "lint": "biome check --write",
    "build": "react-router build",
    "dev": "react-router dev",
    "preview": "pnpm build && node scripts/gen-wrangler.js local && wrangler dev --local",
    "preview:remote": "pnpm build && node scripts/gen-wrangler.js local && wrangler dev",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:cov": "vitest run --coverage",
    "test:out": "vitest run --reporter=json --outputFile=./test-results.json",
    "test:e2e": "playwright test",
    "typecheck": "wrangler types && react-router typegen && tsc -b"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20260701.1",
    "@hono/zod-validator": "0.8.0",
    "awilix": "13.0.5",
    "bcryptjs": "3.0.3",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.27",
    "hono-rate-limiter": "0.5.3",
    "i18next": "26.3.4",
    "isbot": "5.1.44",
    "lucide-react": "1.22.0",
    "postgres": "3.4.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-i18next": "17.0.8",
    "react-router": "8.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@cloudflare/vite-plugin": "1.42.4",
    "@cloudflare/vitest-pool-workers": "0.17.0",
    "@playwright/test": "1.61.1",
    "@react-router/dev": "8.1.0",
    "@tailwindcss/vite": "4.3.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.0.1",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.9",
    "daisyui": "5.6.6",
    "drizzle-kit": "0.31.10",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.2",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vite": "8.1.2",
    "vitest": "4.1.9",
    "wrangler": "4.106.0"
  }
}
