{
  "name": "react-router-cf-starter",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "postinstall": "pnpm typecheck",
    "lint": "biome check --write",
    "build": "react-router build",
    "dev": "react-router dev",
    "preview": "pnpm build && node scripts/gen-wrangler.js local && wrangler dev --local",
    "preview:remote": "pnpm build && node scripts/gen-wrangler.js local && wrangler dev",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:cov": "vitest run --coverage",
    "test:out": "vitest run --reporter=json --outputFile=./test-results.json",
    "test:e2e": "playwright test",
    "typecheck": "wrangler types && react-router typegen && tsc -b"
  },
  "dependencies": {
    "@cloudflare/workers-types": "5.20260910.1",
    "@hono/zod-validator": "0.9.1",
    "awilix": "13.0.5",
    "bcryptjs": "3.0.3",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.7",
    "hono-rate-limiter": "0.5.4",
    "i18next": "26.4.2",
    "isbot": "5.2.2",
    "lucide-react": "1.44.0",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.13",
    "react-router": "8.3.1",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@cloudflare/vite-plugin": "1.54.7",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@playwright/test": "1.63.0",
    "@react-router/dev": "8.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.4.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "daisyui": "5.7.34",
    "drizzle-kit": "0.31.10",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "wrangler": "4.131.0"
  }
}
