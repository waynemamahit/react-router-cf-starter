{
  "name": "react-router-cf-starter",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.20.0"
  },
  "scripts": {
    "postinstall": "pnpm typecheck",
    "lint": "biome check --write",
    "build": "react-router build",
    "dev": "react-router dev",
    "preview": "pnpm build && node scripts/gen-wrangler.js local && wrangler dev --local",
    "preview:remote": "pnpm build && node scripts/gen-wrangler.js local && wrangler dev",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:cov": "vitest run --coverage",
    "test:out": "vitest run --reporter=json --outputFile=./test-results.json",
    "test:e2e": "playwright test",
    "typecheck": "wrangler types && react-router typegen && tsc -b"
  },
  "dependencies": {
    "@cloudflare/workers-types": "5.20260831.1",
    "@hono/zod-validator": "0.9.1",
    "awilix": "13.0.5",
    "bcryptjs": "3.0.3",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.5",
    "hono-rate-limiter": "0.5.3",
    "i18next": "26.4.0",
    "isbot": "5.2.2",
    "lucide-react": "1.38.0",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.12",
    "react-router": "8.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@cloudflare/vite-plugin": "1.54.2",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@playwright/test": "1.62.1",
    "@react-router/dev": "8.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "daisyui": "5.7.22",
    "drizzle-kit": "0.31.10",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  }
}
